{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "vitest.config.mts",
    "playwright.config.mts"
  ],
  "exclude": [
    "tests/unit/main/**/*"
  ]
}
